// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  admin         Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      session[]
  accounts      account[]
  propriedades  propriedade[]

  @@map("users")
}

model session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

model verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// --- TABELAS DE CATÁLOGO GLOBAL ---
// Tabelas compartilhadas entre todos os usuários (sem propriedadeId).
// Gerenciadas via /catalogos/:entidade

model raca {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rebanhos  rebanho[]

  @@map("racas")
}

model sistemaProducao {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rebanhos  rebanho[]

  @@map("sistemas_producao")
}

model regimeAlimentar {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rebanhos  rebanho[]

  @@map("regimes_alimentares")
}

model tipoManejoRebanho {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manejos   manejoRebanho[]

  @@map("tipos_manejo_rebanho")
}

model tipoManejoPasto {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manejos   manejoPasto[]

  @@map("tipos_manejo_pasto")
}

model tipoInsumo {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insumos   insumo[]

  @@map("tipos_insumo")
}

// --- TABELAS DE ESTRUTURA E PROPRIEDADE ---

// ATENÇÃO: existe um índice único PARCIAL em (usuarioId, nome) WHERE ativo = true,
// criado pela migration 20260701120000_partial_unique_index_propriedades.
// Prisma não suporta índices parciais na linguagem do schema (feature partialIndexes
// ainda não implementada) — por isso ele NÃO aparece aqui como @@unique.
// Rode sempre `prisma migrate dev --create-only` para este model e confira o SQL
// gerado antes de aplicar: um diff ingênuo tende a gerar um DROP INDEX deste índice,
// já que o schema não o declara.
model propriedade {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     user     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome        String
  localizacao String?
  areaTotalHa Decimal?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pastos   pasto[]
  rebanhos rebanho[]
  insumos  insumo[]

  @@index([usuarioId])
  @@index([usuarioId, updatedAt])
  @@map("propriedades")
}

// ATENÇÃO: índice único parcial em (propriedadeId, lower(nome)) WHERE ativo = true,
// migration 20260729000000_partial_unique_index_pasto_rebanho. Mesma limitação do
// model propriedade acima — Prisma não suporta índice parcial no schema. Rode
// `prisma migrate dev --create-only` e confira o SQL antes de aplicar.
model pasto {
  id              String      @id @default(uuid())
  propriedadeId   String
  propriedade     propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  nome            String
  extensaoHa      Decimal?
  tipoPastagem    String?
  status          String      @default("Vazio") // Enum validado em application: Ocupado | Vazio | Descanso
  dataUltimaSaida DateTime?
  ativo           Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  rebanhos             rebanho[]
  manejosPasto         manejoPasto[]
  movimentacoesOrigem  historicoMovimentacao[] @relation("PastoOrigem")
  movimentacoesDestino historicoMovimentacao[] @relation("PastoDestino")
  movimentacoesInsumo  movimentacaoInsumo[]

  @@index([propriedadeId])
  @@index([propriedadeId, updatedAt])
  @@map("pastos")
}

// ATENÇÃO: índice único parcial em (propriedadeId, lower(nome)) WHERE ativo = true,
// criado por migration. Prisma não suporta índice parcial no schema — mesma
// ressalva de pasto/rebanho. Rode `prisma migrate dev --create-only` e confira o SQL.
model insumo {
  id            String   @id @default(uuid())
  propriedadeId String
  propriedade   propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  tipoInsumoId  String
  tipoInsumo    tipoInsumo  @relation(fields: [tipoInsumoId], references: [id])
  nome          String
  destino       String   // enum aplicação: Pasto | Rebanho | Ambos
  unidadeMedida String   // enum aplicação: kg | g | L | mL | dose | saco | unidade
  estoqueMinimo Decimal?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movimentacoes  movimentacaoInsumo[]
  regimesConsumo regimeConsumoInsumo[]

  @@index([propriedadeId])
  @@index([propriedadeId, updatedAt])
  @@index([tipoInsumoId])
  @@map("insumos")
}

// --- TABELAS DE ANIMAIS E REBANHO ---

// ATENÇÃO: índice único parcial em (propriedadeId, lower(nomeRebanho)) WHERE ativo = true,
// migration 20260729000000_partial_unique_index_pasto_rebanho. Mesma ressalva do model
// pasto acima — não representável no schema, confira antes de rodar migrate dev.
model rebanho {
  id                    String            @id @default(uuid())
  propriedadeId         String
  propriedade           propriedade       @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  pastoAtualId          String?
  pastoAtual            pasto?            @relation(fields: [pastoAtualId], references: [id], onDelete: SetNull)
  racaId                String?
  raca                  raca?             @relation(fields: [racaId], references: [id], onDelete: SetNull)
  sistemaProducaoId     String?
  sistemaProducao       sistemaProducao?  @relation(fields: [sistemaProducaoId], references: [id], onDelete: SetNull)
  regimeAlimentarId     String?
  regimeAlimentar       regimeAlimentar?  @relation(fields: [regimeAlimentarId], references: [id], onDelete: SetNull)
  nomeRebanho           String
  quantidadeCabecas     Int?
  pesoMedioAtual        Decimal?
  dataEntradaPastoAtual DateTime?
  ativo                 Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  movimentacoes       historicoMovimentacao[]
  manejos             manejoRebanho[]
  regimesConsumo      regimeConsumoInsumo[]
  movimentacoesInsumo movimentacaoInsumo[]

  @@index([propriedadeId])
  @@index([propriedadeId, updatedAt])
  @@index([pastoAtualId])
  @@index([racaId])
  @@index([sistemaProducaoId])
  @@index([regimeAlimentarId])
  @@map("rebanhos")
}

// --- TABELAS DE EVENTOS ---

model historicoMovimentacao {
  id               String   @id @default(uuid())
  rebanhoId        String
  rebanho          rebanho  @relation(fields: [rebanhoId], references: [id], onDelete: Cascade)
  pastoOrigemId    String?
  pastoOrigem      pasto?   @relation("PastoOrigem", fields: [pastoOrigemId], references: [id], onDelete: SetNull)
  pastoDestinoId   String?
  pastoDestino     pasto?   @relation("PastoDestino", fields: [pastoDestinoId], references: [id], onDelete: SetNull)
  dataMovimentacao DateTime @default(now())
  observacoes      String?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([rebanhoId])
  @@index([pastoOrigemId])
  @@index([pastoDestinoId])
  @@index([rebanhoId, updatedAt])
  @@map("historico_movimentacoes")
}

model manejoRebanho {
  id                String            @id @default(uuid())
  rebanhoId         String
  rebanho           rebanho           @relation(fields: [rebanhoId], references: [id], onDelete: Cascade)
  tipoManejoId      String
  tipoManejo        tipoManejoRebanho @relation(fields: [tipoManejoId], references: [id])
  medicamentoVacina String?
  pesoRegistrado    Decimal?
  dataAtividade     DateTime
  observacoes       String?
  ativo             Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  movimentacoesInsumo movimentacaoInsumo[]

  @@index([rebanhoId])
  @@index([tipoManejoId])
  @@index([rebanhoId, updatedAt])
  @@map("manejo_rebanhos")
}

model manejoPasto {
  id            String          @id @default(uuid())
  pastoId       String
  pasto         pasto           @relation(fields: [pastoId], references: [id], onDelete: Cascade)
  tipoManejoId  String
  tipoManejo    tipoManejoPasto @relation(fields: [tipoManejoId], references: [id])
  dataAtividade DateTime
  observacoes   String?
  ativo         Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  movimentacoesInsumo movimentacaoInsumo[]

  @@index([pastoId])
  @@index([tipoManejoId])
  @@index([pastoId, updatedAt])
  @@map("manejo_pastos")
}

/// Ledger de estoque de insumo. Evento com exclusão lógica (`ativo`): a linha
/// precisa persistir para a leitura por diferença reportar a exclusão, igual a
/// `historicoMovimentacao`. Saldo = soma (Entrada + / Saida - / Ajuste com sinal).
/// Cada item de insumo de um manejo é uma linha `Saida` com `manejoXId` preenchido.
model movimentacaoInsumo {
  id              String   @id @default(uuid())
  insumoId        String
  insumo          insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo            String   // enum aplicação: Entrada | Saida | Ajuste
  quantidade      Decimal  // positiva em Entrada/Saida; assinada em Ajuste
  data            DateTime
  origem          String   // enum aplicação: Compra | CadastroInicial | ManejoRebanho | ManejoPasto | ConsumoRebanho | AjusteContagem | Perda
  manejoRebanhoId String?
  manejoRebanho   manejoRebanho? @relation(fields: [manejoRebanhoId], references: [id], onDelete: Cascade)
  manejoPastoId   String?
  manejoPasto     manejoPasto?   @relation(fields: [manejoPastoId], references: [id], onDelete: Cascade)
  rebanhoId       String?
  rebanho         rebanho? @relation(fields: [rebanhoId], references: [id], onDelete: SetNull)
  pastoId         String?
  pasto           pasto?   @relation(fields: [pastoId], references: [id], onDelete: SetNull)
  observacoes     String?
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([insumoId])
  @@index([insumoId, data])
  @@index([insumoId, updatedAt])
  // Sustenta a leitura por diferença por propriedade (sem insumoId): o filtro
  // inicial é `updatedAt > marca`, e o índice composto acima não serve porque
  // sua primeira coluna é insumoId.
  @@index([updatedAt])
  @@index([manejoRebanhoId])
  @@index([manejoPastoId])
  @@map("movimentacoes_insumo")
}

/// Consumo diário recorrente de um insumo por um rebanho. Não escreve no ledger:
/// o saldo projetado é calculado na leitura. Um regime ativo por par
/// (rebanhoId, insumoId) — índice único parcial WHERE ativo = true AND dataFim IS NULL.
model regimeConsumoInsumo {
  id            String   @id @default(uuid())
  rebanhoId     String
  rebanho       rebanho  @relation(fields: [rebanhoId], references: [id], onDelete: Cascade)
  insumoId      String
  insumo        insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  quantidadeDia Decimal
  dataInicio    DateTime
  dataFim       DateTime?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([rebanhoId])
  @@index([insumoId])
  @@map("regimes_consumo_insumo")
}

/// Mutações já aplicadas pelo endpoint de lote.
///
/// O aplicativo reenvia o lote quando a resposta se perde — cenário comum em
/// sinal ruim, que é o caso de uso central do sistema. O registro é gravado na
/// mesma transação da mutação: ou os dois entram, ou nenhum.
///
/// `usuarioId` fica sem relação declarada de propósito, como `session` e
/// `account`: é tabela operacional, não de domínio, e não deve participar de
/// cascata de exclusão do usuário.
model mutacaoAplicada {
  id         String   @id
  usuarioId  String
  entidade   String
  entidadeId String
  resultado  Json
  aplicadaEm DateTime @default(now())

  @@index([usuarioId, aplicadaEm])
  @@map("mutacoes_aplicadas")
}
